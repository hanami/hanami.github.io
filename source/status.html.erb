---
title: Status
---

<h2>Hanami gems CI statuses</h2>

<hr>

<table>
  <% [
    "hanami/cli",
    "hanami/router",
    "hanami/view",
    "hanami/db",
    "hanami/controller",
    "hanami/validations",
    "hanami/assets",
    "hanami/rspec",
    "hanami/reloader",
    "hanami/webconsole",
    "hanami/utils",
  ].map { |repo| [repo, repo.gsub("/", "-")] }.prepend(["hanami/hanami", "hanami"]).each do |repo, gem| %>
    <tr>
      <td>
        <a href="http://github.com/<%= repo %>">
          <%= gem %>
        </a>
      </td>

      <td>
        <a href="http://badge.fury.io/rb/<%= gem %>">
          <img src="https://badge.fury.io/rb/<%= gem %>.svg">
        </a>
      </td>

      <td>
        <a href="https://github.com/<%= repo %>/actions?query=workflow%3Aci+branch%3Amain">
          <img src="https://github.com/<%= repo %>/actions/workflows/ci.yml/badge.svg?branch=main">
        </a>
      </td>
    </tr>
  <% end %>
</table>

<hr>

<h3>Other Hanami Ruby gems</h3>

<table>
  <% [
    "hanami/api",
    "hanami/mailer",
  ].map { |repo| [repo, repo.gsub("/", "-")] }.each do |repo, gem| %>
    <tr>
      <td>
        <a href="http://github.com/<%= repo %>">
          <%= gem %>
        </a>
      </td>

      <td>
        <a href="http://badge.fury.io/rb/<%= gem %>">
          <img src="https://badge.fury.io/rb/<%= gem %>.svg">
        </a>
      </td>

      <td>
        <a href="https://github.com/<%= repo %>/actions?query=workflow%3Aci+branch%3Amain">
          <img src="https://github.com/<%= repo %>/actions/workflows/ci.yml/badge.svg?branch=main">
        </a>
      </td>

      <td>
        <%=
            case repo
            when "hanami/mailer"
              "Needs to be updated for Hanami 2"
            when "hanami/api"
              "A standalone, minimalist API library for Ruby, built on top of hanami-router"
            end
        %>

      </td>
    </tr>
  <% end %>
</table>

